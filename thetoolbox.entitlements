<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: DDC over IOAVService and the Accessibility API both require
	     an unsandboxed app. This is a personal, non-App-Store build. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Required by the hardened release build so the user can explicitly authorize the
	     AppleScript that applies the system-wide pmset disablesleep setting. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
